{{/* boolean feature tags */}}
{{- $ephemeral := false -}}{{/* true if this machine is ephemeral, e.g. a cloud or VM instance */}}
{{- $work := false -}}{{/* true if this machine is a work machine */}}
{{- $headless := false -}}{{/* true if this machine does not have a screen and keyboard */}}
{{- $personal := false -}}{{/* true if this machine should have personal secrets */}}
{{- "" -}}

{{/* operating system identity */}}
{{- $osID := .chezmoi.os -}}
{{- if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{/* detect GitHub codespaces, VSCode remote containers, CI runs, and disposable accounts */}}
{{- if or (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") (env "CI") (eq .chezmoi.username "root" "ubuntu" "vagrant" "vscode") -}}
{{-   $ephemeral = true -}}
{{-   $headless = true -}}
{{- end -}}

{{/* detect Docker/Podman containers, whose state is disposable too */}}
{{- if and (not $ephemeral) (eq .chezmoi.os "linux") -}}
{{-   if eq (output "sh" "-c" "if [ -e /.dockerenv ] || [ -e /run/.containerenv ]; then echo yes; else echo no; fi") "yes" -}}
{{-     $ephemeral = true -}}
{{-     $headless = true -}}
{{-   end -}}
{{- end -}}

{{/* work around unreliable hostname on darwin */}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname = output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}

{{- if eq .chezmoi.os "windows" -}}
{{-   $ephemeral = true -}}
{{- end -}}

{{- if not $ephemeral -}}
{{-   if eq $hostname "macbook-air-m3" -}}
{{-     $personal = true -}}
{{-   else if eq $hostname "daregu-pc" -}}
{{-     $personal = true -}}
{{-   else if eq $hostname "ubuntu" "ubuntu-26" -}}
{{-     $headless = true -}}
{{-     $personal = true -}}
{{-   else if eq $hostname "zrh-mpl3s" -}}
{{-     $work = true -}}
{{-   else if stdinIsATTY -}}
{{-     $headless = promptBoolOnce . "headless" "headless" -}}
{{-     $ephemeral = promptBoolOnce . "ephemeral" "ephemeral" -}}
{{-   else -}}
{{/* Unknown host without a TTY: assume a real workstation, not a disposable one. */}}
{{-     $personal = true -}}
{{-   end -}}
{{- end -}}

{{- $email := "neisserrey@upeu.edu.pe" -}}
{{- if $work -}}
{{-   $email = "neisserrey@upeu.edu.pe" -}}
{{- end -}}

[data]
    ephemeral = {{ $ephemeral }}
    email = {{ $email | quote }}
    work = {{ $work }}
    headless = {{ $headless }}
    hostname = {{ $hostname | quote }}
    personal = {{ $personal }}
    osid = {{ $osID | quote }}

[github]
    refreshPeriod = "12h"

[status]
    exclude = ["scripts"]

[diff]
    exclude = ["scripts"]
