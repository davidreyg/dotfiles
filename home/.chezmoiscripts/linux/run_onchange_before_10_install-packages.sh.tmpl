{{- if .is_apt_based -}}
{{- $packages := list
     "bat"
     "build-essential"
     "curl"
     "fd-find"
     "fzf"
     "git"
     "git-lfs"
     "libfuse2"
     "openssh-server"
     "ripgrep"
     "shellcheck"
     "units"
     "zsh" -}}
{{- $snaps := list -}}
{{- $classicSnaps := list -}}

{{- if .is_ubuntu_like -}}
{{-   $packages = mustAppend $packages "btop" -}}
{{- end -}}

{{- if not .is_headless -}}
{{-   $packages = mustAppend $packages "xclip" -}}
{{- end -}}

{{- $sudo := "sudo " -}}
{{- if eq .chezmoi.username "root" -}}
{{-   $sudo = "" -}}
{{- end -}}
#!/bin/bash

set -eufo pipefail

PACKAGES=(
{{- range $packages }}
    {{ . | quote }}
{{- end }}
)

{{ $sudo }}apt-get update
{{ $sudo }}apt-get install -y "${PACKAGES[@]}"

{{ if lookPath "snap" }}
{{-   range $snaps }}
( snap info {{ . }} | grep -q ^installed: ) || {{ $sudo }}snap install {{ . }}
{{-   end }}
{{-   range $classicSnaps }}
( snap info {{ . }} | grep -q ^installed: ) || {{ $sudo }}snap install --classic {{ . }}
{{-   end }}
{{ end }}
{{- end -}}
