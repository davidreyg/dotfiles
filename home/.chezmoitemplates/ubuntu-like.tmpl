{{- /*
  Devuelve "true" cuando el sistema pertenece a la familia Debian/Ubuntu que
  puede usar los externals y paquetes con sabor Ubuntu, y "" en caso contrario.
  Se apoya en ID_LIKE de os-release para cubrir derivadas (Linux Mint,
  Pop!_OS, Zorin, elementary, ...) sin enumerar cada osid.
*/ -}}
{{- $ubuntuLike := eq .osid "linux-ubuntu" -}}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "idLike") -}}
{{-   $ubuntuLike = or $ubuntuLike (contains "ubuntu" .chezmoi.osRelease.idLike) -}}
{{- end -}}
{{- if $ubuntuLike -}}true{{- end -}}
